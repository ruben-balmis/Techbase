@model List<TechBase.Models.Producto>

<h2>Catálogo de productos</h2>

<div style="display:flex; flex-wrap:wrap; gap:20px;">
    @foreach (var producto in Model)
    {
        <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@producto.IdProducto"
           style="text-decoration:none; color:inherit; display:block;">

            <div style="border:1px solid #ccc; padding:15px; width:200px;">

                <img src="~/images/productos/@producto.ImagenUrl"
                     style="width:100%; height:150px; object-fit:cover;" />

                <h4>@producto.Nombre</h4>

                <p>@producto.Descripcion</p>

                <p><strong>@producto.Precio €</strong></p>

                <p>Stock: @producto.Stock</p>

                <p>Categoría: @producto.Categoria.Nombre</p>

            </div>

        </a>
        <a asp-controller="Carrito"
           asp-action="Agregar"
           asp-route-id="@producto.IdProducto"
           asp-route-nombre="@producto.Nombre"
           asp-route-precio="@producto.Precio"
           style="display:block; margin-top:10px; background-color:green; color:white; padding:5px; text-align:center;">
            Añadir al carrito
        </a>
    }
</div>