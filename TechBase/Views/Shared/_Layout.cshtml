<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechBase</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechBase.styles.css" asp-append-version="true" />
    <link rel="stylesheet"href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom mb-4" style="background-color: #b2ddeb">
            <div class="container-fluid">
                <a class="navbar-brand techbase-card"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <div style="display:flex; align-items:center;">
                        <img src="~/images/logo.png"
                             style="
                            width:48px;
                            height:40px;
                            object-fit:contain;
                        " />
                        <span style="margin-left:10px; font-weight:bold;">
                            TechBase Store
                        </span>
                    </div>

                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="AdminPedidos" asp-action="Index">
                                    Pedidos (Admin)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="AdminProductos" asp-action="Index">
                                    Productos (Admin)
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Productos" asp-action="Index" style="font-weight:bold;">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Carrito" asp-action="Index">Carrito</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Carrito" asp-action="MisPedidos">Mis pedidos</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TechBase - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <footer style="
    background:#1f1f1f;
    color:white;
    margin-top:60px;
    padding:40px 20px;
">

        <div style="
        max-width:1200px;
        margin:auto;
        display:flex;
        justify-content:space-between;
        flex-wrap:wrap;
        gap:40px;
    ">

            <!-- IZQUIERDA -->
            <div>

                <h3 style="margin-bottom:15px;">
                    TechBase Store
                </h3>

                <p style="color:#ccc; max-width:300px;">
                    Tu tienda online especializada en componentes gaming y hardware de alto rendimiento.
                </p>

            </div>

            <!-- CENTRO -->
            <div>

                <h4 style="margin-bottom:15px;">
                    Navegación
                </h4>

                <div style="
                display:flex;
                flex-direction:column;
                gap:10px;
            ">

                    <a asp-controller="Home"
                       asp-action="Index"
                       style="color:white; text-decoration:none;">

                        Inicio

                    </a>

                    <a asp-controller="Productos"
                       asp-action="Index"
                       style="color:white; text-decoration:none;">

                        Productos

                    </a>

                    <a asp-controller="Carrito"
                       asp-action="Index"
                       style="color:white; text-decoration:none;">

                        Carrito

                    </a>

                </div>

            </div>

            <!-- DERECHA -->
            <div>

                <h4 style="margin-bottom:15px;">
                    Contacto
                </h4>

                <p>📧 soporte@techbase.com</p>

                <p>📍 España</p>

            </div>

        </div>

        <hr style="
        margin:30px 0;
        border-color:#444;
    " />

        <div style="
        text-align:center;
        color:#aaa;
    ">

            © 2026 TechBase Store - Todos los derechos reservados

        </div>

    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
