@model List<TechBase.Models.Producto>

<div style="
    background: linear-gradient(135deg, #111, #1e1e1e);
    color: white;
    padding: 100px 20px;
    text-align: center;
    border-radius: 20px;
    margin-top: 20px;
">

    <div style="margin-bottom:20px;">

        <img src="~/images/logo.png"
             style="
            width:180px;
            height:auto;
         " />

    </div>

    <h1 style="
        font-size:60px;
        font-weight:bold;
        margin-bottom:20px;
    ">
        TECHBASE STORE
    </h1>

    <p style="
        font-size:24px;
        color:#ccc;
        margin-bottom:40px;
    ">
        Potencia tu setup gaming con los mejores componentes
    </p>

    <a asp-controller="Productos"
       asp-action="Index"
       style="
            background:#0d6efd;
            color:white;
            padding:15px 35px;
            border-radius:12px;
            text-decoration:none;
            font-size:20px;
            font-weight:bold;
            transition:0.3s;"
       onmouseover="this.style.background='#0b5ed7'"
       onmouseout="this.style.background='#0d6efd'">

        Ver catálogo

    </a>

</div>

<div id="techbaseCarousel"
     class="carousel slide mt-5"
     data-bs-ride="carousel">

    <div class="carousel-inner rounded shadow">

        <!-- SLIDE 1 -->
        <div class="carousel-item active">

            <img src="~/images/productos/rtx5070.jpg"
                 class="d-block w-100"
                 style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block"
                 style="background:rgba(0,0,0,0.5); border-radius:10px;">

                <h2>RTX 5070 Ti</h2>

                <p>Potencia extrema para gaming</p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-primary">

                    Ver productos

                </a>

            </div>

        </div>

        <!-- SLIDE 2 -->
        <div class="carousel-item">

            <img src="~/images/productos/7-9800X3D.jpg"
                 class="d-block w-100"
                 style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block"
                 style="background:rgba(0,0,0,0.5); border-radius:10px;">

                <h2>Ryzen 7 9800X3D</h2>

                <p>Máximo rendimiento gaming</p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-primary">

                    Ver productos

                </a>

            </div>

        </div>

        <!-- SLIDE 3 -->
        <div class="carousel-item">

            <img src="~/images/productos/Samsung-1TB.jpg"
                 class="d-block w-100"
                 style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block"
                 style="background:rgba(0,0,0,0.5); border-radius:10px;">

                <h2>Samsung 990 PRO</h2>

                <p>Velocidad NVMe de última generación</p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-primary">

                    Ver productos

                </a>

            </div>

        </div>

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#techbaseCarousel"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"
              style="
        background-color:rgba(0,0,0,0.7);
        border-radius:50%;
        padding:20px;
      ">
        </span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#techbaseCarousel"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"
              style="
        background-color:rgba(0,0,0,0.7);
        border-radius:50%;
        padding:20px;
      ">
        </span>

    </button>

</div>
<div class="mt-5">

    <h2 style="margin-bottom:30px;">
        ⭐ Productos destacados
    </h2>

    <div style="
        display:flex;
        gap:30px;
        flex-wrap:wrap;
        justify-content:center;
    ">

        @foreach (var producto in Model)
        {
            <div style="
                    border:1px solid #ddd;
                    border-radius:12px;
                    padding:15px;
                    width:220px;
                    background:white;
                    box-shadow:0 2px 8px rgba(0,0,0,0.1);
                    transition:0.3s;
                "
                 onmouseover="this.style.transform='scale(1.03)'"
                 onmouseout="this.style.transform='scale(1)'">

                <img src="~/images/productos/@producto.ImagenUrl"
                     style="
                            width:100%;
                            height:180px;
                            object-fit:contain;
                         " />

                <h5>@producto.Nombre</h5>

                <p>
                    <strong>@producto.Precio €</strong>
                </p>

                <a asp-controller="Productos"
                   asp-action="Detalle"
                   asp-route-id="@producto.IdProducto"
                   class="btn btn-primary w-100">

                    Ver producto

                </a>

            </div>
        }

    </div>

</div>