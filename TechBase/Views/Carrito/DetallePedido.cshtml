@model List<TechBase.Models.DetallePedido>

<h2>Detalle del pedido</h2>

<p><strong>Pedido:</strong> @ViewBag.Pedido.IdPedido</p>
<p><strong>Fecha:</strong> @ViewBag.Pedido.Fecha</p>
<p><strong>Estado:</strong> @ViewBag.Pedido.Estado.Nombre</p>
<p><strong>Total:</strong> @ViewBag.Pedido.Total €</p>

<table>
    <tr>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Precio unitario</th>
        <th>Total</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Producto.Nombre</td>
            <td>@item.Cantidad</td>
            <td>@item.PrecioUnitario €</td>
            <td>@(item.Cantidad * item.PrecioUnitario) €</td>
        </tr>
    }
</table>

<a asp-controller="Carrito" asp-action="MisPedidos">Volver</a>
