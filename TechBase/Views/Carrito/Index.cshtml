@model List<TechBase.Models.CarritoItem>

<h2>Carrito</h2>

@if (!Model.Any())
{
    <p>El carrito está vacío</p>
}
else
{
    <table>
        <th>Acciones</th>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th>Cantidad</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio €</td>
                <td>
                    <a asp-controller="Carrito" asp-action="Restar" asp-route-id="@item.IdProducto">➖</a>

                    @item.Cantidad

                    <a asp-controller="Carrito" asp-action="Sumar" asp-route-id="@item.IdProducto">➕</a>
                </td>
            </tr>
            <td>
                <a asp-controller="Carrito"
                   asp-action="Eliminar"
                   asp-route-id="@item.IdProducto"
                   style="color:red;">
                    Eliminar
                </a>
            </td>
        }
    </table>
}
@if (Model.Any())
{
    <a asp-controller="Carrito" asp-action="Confirmar"
       style="display:block; margin-top:20px; background-color:green; color:white; padding:10px; text-align:center;">
        Confirmar pedido
    </a>
}
