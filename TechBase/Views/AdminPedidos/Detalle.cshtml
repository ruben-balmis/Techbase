@model List<TechBase.Models.DetallePedido>

<h2>Detalle pedido (Admin)</h2>

<p><strong>Usuario:</strong> @ViewBag.Pedido.Usuario?.Email</p>
<p><strong>Estado:</strong> @ViewBag.Pedido.Estado?.Nombre</p>

<table>
    <tr>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Precio</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Producto.Nombre</td>
            <td>@item.Cantidad</td>
            <td>@item.PrecioUnitario €</td>
        </tr>
    }
</table>
