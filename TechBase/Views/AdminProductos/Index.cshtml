@model IEnumerable<TechBase.Models.Producto>

<h2>Administrar Productos</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        Crear nuevo producto
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="~/images/productos/@item.ImagenUrl" style="width:80px; height:80px; object-fit:contain;" />
                </td>
                <td>@item.Nombre</td>
                <td>@item.Precio €</td>
                <td>@item.Stock</td>
                <td>@item.Categoria.Nombre</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.IdProducto"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>